/*
Code Name: ESP32 Wifi Control Car
Description: Control a robot using a web app via ESP32 in AP mode.
*/

#define ENA   22          // Motor Right Speed
#define ENB   23          // Motor Left Speed
#define IN_1  5          // Motor Right IN1
#define IN_2  18          // Motor Right IN2
#define IN_3  19          // Motor Left IN3
#define IN_4  21          // Motor Left IN4

#include <WiFi.h>
#include <WebServer.h>

String command;
int speedCar = 800;      // PWM range: 0 - 1023
int speed_Coeff = 3;

const char* ssid = "Dheeraj Nsd";
WebServer server(80);

// PWM Channels for ESP32
#define PWM_FREQ     1000
#define PWM_RES      10
#define ENA_CHANNEL  0
#define ENB_CHANNEL  1

void setup() {
  Serial.begin(115200);

  pinMode(IN_1, OUTPUT);
  pinMode(IN_2, OUTPUT);
  pinMode(IN_3, OUTPUT);
  pinMode(IN_4, OUTPUT);

  // Setup PWM
  ledcSetup(ENA_CHANNEL, PWM_FREQ, PWM_RES);
  ledcAttachPin(ENA, ENA_CHANNEL);

  ledcSetup(ENB_CHANNEL, PWM_FREQ, PWM_RES);
  ledcAttachPin(ENB, ENB_CHANNEL);

  // WiFi Access Point
  WiFi.softAP(ssid);
  Serial.print("AP IP address: ");
  Serial.println(WiFi.softAPIP());

  server.on("/", HTTP_handleRoot);
  server.onNotFound(HTTP_handleRoot);
  server.begin();
}

void goAhead() {
  digitalWrite(IN_1, LOW);
  digitalWrite(IN_2, HIGH);
  ledcWrite(ENA_CHANNEL, speedCar);

  digitalWrite(IN_3, LOW);
  digitalWrite(IN_4, HIGH);
  ledcWrite(ENB_CHANNEL, speedCar);
}

void goBack() {
  digitalWrite(IN_1, HIGH);
  digitalWrite(IN_2, LOW);
  ledcWrite(ENA_CHANNEL, speedCar);

  digitalWrite(IN_3, HIGH);
  digitalWrite(IN_4, LOW);
  ledcWrite(ENB_CHANNEL, speedCar);
}

void goRight() {
  digitalWrite(IN_1, HIGH);
  digitalWrite(IN_2, LOW);
  ledcWrite(ENA_CHANNEL, speedCar);

  digitalWrite(IN_3, LOW);
  digitalWrite(IN_4, HIGH);
  ledcWrite(ENB_CHANNEL, speedCar);
}

void goLeft() {
  digitalWrite(IN_1, LOW);
  digitalWrite(IN_2, HIGH);
  ledcWrite(ENA_CHANNEL, speedCar);

  digitalWrite(IN_3, HIGH);
  digitalWrite(IN_4, LOW);
  ledcWrite(ENB_CHANNEL, speedCar);
}

void goAheadRight() {
  digitalWrite(IN_1, LOW);
  digitalWrite(IN_2, HIGH);
  ledcWrite(ENA_CHANNEL, speedCar / speed_Coeff);

  digitalWrite(IN_3, LOW);
  digitalWrite(IN_4, HIGH);
  ledcWrite(ENB_CHANNEL, speedCar);
}

void goAheadLeft() {
  digitalWrite(IN_1, LOW);
  digitalWrite(IN_2, HIGH);
  ledcWrite(ENA_CHANNEL, speedCar);

  digitalWrite(IN_3, LOW);
  digitalWrite(IN_4, HIGH);
  ledcWrite(ENB_CHANNEL, speedCar / speed_Coeff);
}

void goBackRight() {
  digitalWrite(IN_1, HIGH);
  digitalWrite(IN_2, LOW);
  ledcWrite(ENA_CHANNEL, speedCar / speed_Coeff);

  digitalWrite(IN_3, HIGH);
  digitalWrite(IN_4, LOW);
  ledcWrite(ENB_CHANNEL, speedCar);
}

void goBackLeft() {
  digitalWrite(IN_1, HIGH);
  digitalWrite(IN_2, LOW);
  ledcWrite(ENA_CHANNEL, speedCar);

  digitalWrite(IN_3, HIGH);
  digitalWrite(IN_4, LOW);
  ledcWrite(ENB_CHANNEL, speedCar / speed_Coeff);
}

void stopRobot() {
  digitalWrite(IN_1, LOW);
  digitalWrite(IN_2, LOW);
  ledcWrite(ENA_CHANNEL, 0);

  digitalWrite(IN_3, LOW);
  digitalWrite(IN_4, LOW);
  ledcWrite(ENB_CHANNEL, 0);
}

void loop() {
  server.handleClient();

  command = server.arg("State");
  if (command == "F") goAhead();
  else if (command == "B") goBack();
  else if (command == "L") goLeft();
  else if (command == "R") goRight();
  else if (command == "I") goAheadRight();
  else if (command == "G") goAheadLeft();
  else if (command == "J") goBackRight();
  else if (command == "H") goBackLeft();
  else if (command == "0") speedCar = 400;
  else if (command == "1") speedCar = 470;
  else if (command == "2") speedCar = 540;
  else if (command == "3") speedCar = 610;
  else if (command == "4") speedCar = 680;
  else if (command == "5") speedCar = 750;
  else if (command == "6") speedCar = 820;
  else if (command == "7") speedCar = 890;
  else if (command == "8") speedCar = 960;
  else if (command == "9") speedCar = 1023;
  else if (command == "S") stopRobot();
}

void HTTP_handleRoot() {
  if (server.hasArg("State")) {
    Serial.println(server.arg("State"));
  }
  server.send(200, "text/html", "");
  delay(1);
}
